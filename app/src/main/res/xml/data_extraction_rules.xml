<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Include general app data -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>

        <!-- Exclude sensitive items -->
        <exclude domain="sharedpref" path="api_keys_secure_prefs.xml"/>
        <exclude domain="database" path="mermaid_database"/>
        <exclude domain="database" path="mermaid_database-shm"/>
        <exclude domain="database" path="mermaid_database-wal"/>
        <exclude domain="file" path=".*key.*"/>
        <exclude domain="file" path=".*token.*"/>
        <exclude domain="file" path=".*secret.*"/>
    </cloud-backup>
    
    <device-transfer>
        <!-- Include most app data for device transfer -->
        <include domain="sharedpref" path="."/>
        <include domain="database" path="."/>
        <include domain="file" path="."/>
        
        <!-- Exclude sensitive data from device transfer -->
        <exclude domain="sharedpref" path="api_keys_secure_prefs.xml"/>
        <exclude domain="database" path="room_master_table.db"/>
        <exclude domain="database" path="room_master_table.db-shm"/>
        <exclude domain="database" path="room_master_table.db-wal"/>
        <exclude domain="file" path=".*key.*"/>
        <exclude domain="file" path=".*token.*"/>
        <exclude domain="file" path=".*secret.*"/>
    </device-transfer>
</data-extraction-rules>