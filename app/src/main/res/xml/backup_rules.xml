<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Include most app data -->
    <include domain="sharedpref" path="."/>
    <include domain="database" path="."/>
    <include domain="file" path="."/>

    <!-- Exclude sensitive data -->
    <exclude domain="sharedpref" path="api_keys_secure_prefs.xml"/>
    <exclude domain="database" path="mermaid_database"/>
    <exclude domain="database" path="mermaid_database-shm"/>
    <exclude domain="database" path="mermaid_database-wal"/>
    <exclude domain="file" path=".*key.*"/>
    <exclude domain="file" path=".*token.*"/>
    <exclude domain="file" path=".*secret.*"/>
</full-backup-content>